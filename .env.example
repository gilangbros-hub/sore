# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.

# Public site URL, no trailing slash (used in WhatsApp messages and the Story image)
# Optional: falls back to the Vercel production domain
NEXT_PUBLIC_SITE_URL=

# Supabase: Project Settings → API Keys (the secret key never reaches the browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Admin login at /admin (min. 12 characters)
ADMIN_PASSWORD=

# Random strings. Generate with: openssl rand -hex 24
CRON_SECRET=

# Lynk.id → Settings → Integrations → Webhook. The merchant key appears after you save the webhook URL.
LYNK_MERCHANT_KEY=

# WhatsApp number and Lynk.id product links are hardcoded in src/lib/config.ts

# Optional: map Lynk product titles to products if the keyword guess fails
# LYNK_PRODUCT_MAP={"Ramalan 3 kartu":"tarot","Paket Senja":"bundle"}

# Operating hours in WIB (shown on the status page and FAQ)
NEXT_PUBLIC_JAM_TUTUP=22.00
NEXT_PUBLIC_JAM_BUKA=08.00
